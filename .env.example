# Contact address placed in the User-Agent of every request to data sources:
# PrijePotpisa/0.1 (+CONTACT_EMAIL)
CONTACT_EMAIL=

# Optional language model for the assistant (any OpenAI-compatible API).
# Without these the assistant uses simple keyword rules over the same tools.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Walking router (Valhalla). Default matches `make dev`.
VALHALLA_URL=http://localhost:8002

# Production only (deploy/docker-compose.yml): public domain for Caddy HTTPS.
DOMAIN=localhost
