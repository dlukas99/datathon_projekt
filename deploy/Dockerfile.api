# Backend API: FastAPI + rasterio. Processed data is mounted at /data/processed.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /usr/local/bin/uv
# rasterio wheels bundle GDAL but need the system expat library.
RUN apt-get update && apt-get install -y --no-install-recommends libexpat1 \
    && rm -rf /var/lib/apt/lists/*
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUTF8=1 \
    DATA_DIR=/data VALHALLA_URL=http://valhalla:8002
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-default-groups --no-install-project
COPY backend/app ./app
COPY backend/analysis ./analysis
COPY backend/ingest ./ingest
RUN uv sync --frozen --no-default-groups
RUN useradd --create-home appuser
USER appuser
EXPOSE 8000
CMD ["uv", "run", "--no-sync", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers", "--no-access-log"]
